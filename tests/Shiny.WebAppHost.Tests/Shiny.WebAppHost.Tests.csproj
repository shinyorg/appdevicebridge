<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Shiny.WebAppHost.Tests</RootNamespace>

    <!-- xunit v3 runs on Microsoft.Testing.Platform: the test assembly is its own runner. -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
  </ItemGroup>

  <!--
    A web app zipped into the test assembly, exactly as a real app embeds its own: it is what proves an app
    can ship with nothing but an embedded build — no update server, no manifest, no signing key.
  -->
  <Target Name="EmbedBaseline" BeforeTargets="AssignTargetPaths">
    <PropertyGroup>
      <BaselineZip>$(IntermediateOutputPath)baseline.zip</BaselineZip>
    </PropertyGroup>
    <ZipDirectory SourceDirectory="$(MSBuildThisFileDirectory)baseline" DestinationFile="$(BaselineZip)" Overwrite="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(BaselineZip)" LogicalName="Shiny.WebAppHost.Tests.baseline.zip" Visible="false" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="../../src/Shiny.WebAppHost.Core/Shiny.WebAppHost.Core.csproj" />
    <ProjectReference Include="../../src/Shiny.WebAppHost/Shiny.WebAppHost.csproj" />
    <ProjectReference Include="../../src/Shiny.WebAppHost.AspNetCore/Shiny.WebAppHost.AspNetCore.csproj" />
  </ItemGroup>

</Project>
