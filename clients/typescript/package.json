{
  "name": "@shinyorg/appdevicebridge",
  "version": "1.0.0-beta",
  "description": "Typed clients for the bridges of a web app hosted by Shiny.AppDeviceBridge. Generated from the same declarations as the C# clients.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shinyorg/appdevicebridge",
    "directory": "clients/typescript"
  }
}
