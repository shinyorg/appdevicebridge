<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Plain HTTP to 127.0.0.1, where the web app is served. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Discovery bridge: iOS only browses and advertises the service types listed here. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>The sample web app finds and advertises services on your local network.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_http._tcp</string>
		<string>_webapphost._tcp</string>
	</array>

	<key>NSLocationUsageDescription</key>
	<string>The sample web app shows your position.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>The sample web app scans for Bluetooth LE devices.</string>
</dict>
</plist>
