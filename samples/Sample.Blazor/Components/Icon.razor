@* A line icon on a 24×24 grid, drawn in the current text colour. *@
<svg class="icon" viewBox="0 0 24 24" width="@Size" height="@Size" aria-hidden="true"
     fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    @switch (Name)
    {
        case "home":
            <path d="M3 11 12 3l9 8" /><path d="M5 10v10h14V10" /><path d="M10 20v-6h4v6" />
            break;
        case "phone":
            <rect x="6" y="2.5" width="12" height="19" rx="2.5" /><path d="M11 18h2" />
            break;
        case "pulse":
            <path d="M3 12h4l2.5-6 5 12 2.5-6h4" />
            break;
        case "monitor":
            <rect x="2.5" y="4" width="19" height="12.5" rx="2" /><path d="M8 20.5h8M12 16.5v4" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
            break;
        case "pin":
            <path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" />
            break;
        case "film":
            <rect x="3" y="4" width="18" height="16" rx="2" /><path d="M7 4v16M17 4v16M3 9h4M3 15h4M17 9h4M17 15h4" />
            break;
        case "camera":
            <path d="M4 7h3l2-2.5h6L17 7h3a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1Z" /><circle cx="12" cy="13" r="3.5" />
            break;
        case "image":
            <rect x="3" y="3.5" width="18" height="17" rx="2" /><circle cx="8.5" cy="9" r="1.8" /><path d="m21 16-5-5-9 9.5" />
            break;
        case "chip":
            <rect x="6" y="6" width="12" height="12" rx="1.5" /><rect x="9.5" y="9.5" width="5" height="5" /><path d="M9 2.5v3.5M15 2.5v3.5M9 18v3.5M15 18v3.5M2.5 9H6M2.5 15H6M18 9h3.5M18 15h3.5" />
            break;
        case "mic":
            <rect x="9" y="2.5" width="6" height="12" rx="3" /><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5v4" />
            break;
        case "wifi":
            <path d="M2.5 8.5a14 14 0 0 1 19 0M5.5 12a9.5 9.5 0 0 1 13 0M8.5 15.5a5 5 0 0 1 7 0" /><circle cx="12" cy="19" r="0.9" fill="currentColor" />
            break;
        case "bluetooth":
            <path d="m7 7 10 10-5 4.5v-19L17 7 7 17" />
            break;
        case "car":
            <path d="M5 16v3M19 16v3M3.5 16h17v-4l-2-5.5h-13l-2 5.5Z" /><circle cx="7.5" cy="12.8" r="1" fill="currentColor" /><circle cx="16.5" cy="12.8" r="1" fill="currentColor" />
            break;
        case "radar":
            <circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="5" /><path d="M12 12 18.5 5.5" /><circle cx="12" cy="12" r="1" fill="currentColor" />
            break;
        case "transfer":
            <path d="M7 3.5v16M3.5 16 7 19.5l3.5-3.5M17 20.5v-16M13.5 8 17 4.5 20.5 8" />
            break;
        case "bell":
            <path d="M6 16.5V11a6 6 0 0 1 12 0v5.5l1.5 2h-15Z" /><path d="M10 21h4" />
            break;
        case "message":
            <path d="M4 4.5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1h-9l-5 4v-4H4a1 1 0 0 1-1-1v-10a1 1 0 0 1 1-1Z" />
            break;
        case "link":
            <path d="M10 14a4.5 4.5 0 0 0 6.4 0l3-3a4.5 4.5 0 0 0-6.4-6.4l-1 1" /><path d="M14 10a4.5 4.5 0 0 0-6.4 0l-3 3a4.5 4.5 0 0 0 6.4 6.4l1-1" />
            break;
        case "users":
            <circle cx="9" cy="8" r="3.5" /><path d="M2.5 20a6.5 6.5 0 0 1 13 0" /><path d="M16 4.8a3.5 3.5 0 0 1 0 6.4M18 14.5a6.5 6.5 0 0 1 3.5 5.5" />
            break;
        case "calendar":
            <rect x="3" y="4.5" width="18" height="16" rx="2" /><path d="M3 9.5h18M8 2.5v4M16 2.5v4" />
            break;
        case "heart":
            <path d="M12 20s-8-4.7-8-10.5A4.5 4.5 0 0 1 12 7a4.5 4.5 0 0 1 8 2.5C20 15.3 12 20 12 20Z" />
            break;
        case "database":
            <ellipse cx="12" cy="5.5" rx="8" ry="3" /><path d="M4 5.5v13c0 1.7 3.6 3 8 3s8-1.3 8-3v-13M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3" />
            break;
        case "folder":
            <path d="M3 6.5a1 1 0 0 1 1-1h5l2 2.5h9a1 1 0 0 1 1 1v9.5a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1Z" />
            break;
        case "menu":
            <path d="M4 7h16M4 12h16M4 17h16" />
            break;
        case "close":
            <path d="M6 6l12 12M18 6 6 18" />
            break;
        case "bolt":
            <path d="M13 2.5 4.5 13.5H12l-1 8 8.5-11H12Z" />
            break;
        default:
            <circle cx="12" cy="12" r="8" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 18;
}
