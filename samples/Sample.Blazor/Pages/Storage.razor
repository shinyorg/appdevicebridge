@page "/storage"
@inherits BridgePage
@inject ISettingsBridge SettingsBridge
@inject IFilesBridge FilesBridge

<h1>Storage</h1>

<h2>Settings</h2>
<div class="form">
    <select @bind="scope">
        <option value="@SettingsScope.Local">local</option>
        <option value="@SettingsScope.Secure">secure</option>
    </select>
    <input @bind="key" placeholder="key" />
    <input @bind="value" placeholder='JSON value, e.g. "hello" or { "a": 1 }' />
</div>
<div class="actions">
    <button @onclick="SaveSetting">Save</button>
    <button @onclick="@(() => Run(() => SettingsBridge.GetValueAsync(scope, key), Json.JsonElement))">Load</button>
    <button @onclick="@(() => Run(() => SettingsBridge.ListAsync(scope), Json.SettingsList))">List</button>
    <button @onclick="@(() => Run(() => SettingsBridge.RemoveAsync(scope, key), "Removed."))">Delete</button>
</div>

<h2>Files <span class="muted">(data root)</span></h2>
<div class="form">
    <input @bind="path" placeholder="notes/today.txt" />
    <input @bind="content" placeholder="file contents" />
</div>
<div class="actions">
    <button @onclick="@(() => Run(() => FilesBridge.WriteTextAsync("data", path, content), Json.FileEntry))">Write</button>
    <button @onclick="@(() => Run(() => FilesBridge.ReadTextAsync("data", path), Json.String))">Read</button>
    <button @onclick="@(() => Run(() => FilesBridge.ListAsync("data", Folder), Json.IReadOnlyListFileEntry))">List folder</button>
    <button @onclick="@(() => Run(() => FilesBridge.DeleteAsync("data", path, recursive: true), "Deleted."))">Delete</button>
</div>

<Output Value="@Output" Error="@Error" />

@code {
    static AppDeviceBridgeJsonContext Json => AppDeviceBridgeJsonContext.Default;

    SettingsScope scope = SettingsScope.Local;
    string key = "greeting";
    string value = "\"hello\"";
    string path = "notes/today.txt";
    string content = "Written from Blazor";

    string Folder => path.Contains('/') ? path[..path.LastIndexOf('/')] : String.Empty;

    Task SaveSetting() => Run(async () =>
    {
        // Any JSON the user typed. A page with its own types calls SetAsync(scope, key, value, typeInfo) instead.
        using var document = JsonDocument.Parse(value);
        await SettingsBridge.SetValueAsync(scope, key, document.RootElement);
        return await SettingsBridge.ListAsync(scope);
    }, Json.SettingsList);
}
