@page "/bluetooth"
@inherits BridgePage
@inject IBluetoothLEBridge BleBridge

<h1>Bluetooth LE</h1>

<div class="actions">
    <button @onclick="Scan">Scan</button>
    <button @onclick="@(() => Run(() => BleBridge.StopScanAsync(), "Stopped."))">Stop</button>
    <button @onclick="@(() => Run(() => BleBridge.GetConnectedPeripheralsAsync(), Json.IReadOnlyListBlePeripheral))">Connected</button>
</div>

<Output Value="@Output" Error="@Error" />

<ul class="list">
    @foreach (var p in peripherals.Values.OrderByDescending(x => x.Rssi).Take(40))
    {
        <li><strong>@(p.Name ?? p.LocalName ?? "(unnamed)")</strong> <span class="muted">@p.Rssi dBm · @p.Uuid</span></li>
    }
</ul>

@code {
    static BleJsonContext Json => BleJsonContext.Default;

    readonly Dictionary<string, BleScanResult> peripherals = [];

    protected override Task OnInitializedAsync()
        => Listen<BleScanResult>(BleBridge.OnScanResultAsync, e => peripherals[e.Uuid] = e);

    Task Scan() => Run(async () =>
    {
        await BleBridge.RequestAccessAsync();
        peripherals.Clear();
        await BleBridge.StartScanAsync(new BleScanRequest());
    }, "Scanning.");
}
