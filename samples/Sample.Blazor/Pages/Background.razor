@page "/background"
@inherits BridgePage
@inject ISettingsBridge SettingsBridge
@inject IFilesBridge FilesBridge
@inject NativeCallHandlers Handlers

<h1>Background</h1>
<p class="muted">
    Jobs, background GPS readings, geofence transitions and pushes are handled by this page while it is open —
    listed below — and by background.js when it is not.
</p>

<div class="actions">
    <button @onclick="Refresh">What background.js did</button>
</div>

<Output Value="@Output" Error="@Error" />

<h2>Handled here</h2>
<pre class="log">@String.Join("\n", Handlers.Calls)</pre>

@code {
    protected override void OnInitialized() => Handlers.Changed += OnChanged;

    void OnChanged() => InvokeAsync(StateHasChanged);

    // background.js writes these through the same settings and files bridges.
    Task Refresh() => Run(async () =>
    {
        var runs = await SettingsBridge.GetAsync(SettingsScope.Local, "sync-runs", SampleJson.Default.Int32);
        var last = await SettingsBridge.GetAsync(SettingsScope.Local, "last-background-position", SampleJson.Default.NullableJsonElement);

        string log;
        try
        {
            log = await FilesBridge.ReadTextAsync("data", "background.log");
        }
        catch (BridgeException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            log = "(nothing yet)";
        }

        return new BackgroundReport(runs, last, log);
    }, SampleJson.Default.BackgroundReport);

    public override ValueTask DisposeAsync()
    {
        Handlers.Changed -= OnChanged;
        return base.DisposeAsync();
    }
}
