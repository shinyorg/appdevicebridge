@page "/speech"
@inherits BridgePage
@inject ISpeechBridge SpeechBridge

<h1>Speech</h1>
<p class="muted">On-device recognition and text-to-speech. Linux has no OS speech engine, so every call there answers 501.</p>

<h2>Text-to-speech</h2>
<div class="form">
    <input @bind="text" placeholder="Something to say" />
    <button @onclick="Speak">Speak</button>
    <button @onclick="@(() => Run(() => SpeechBridge.StopSpeakingAsync(), "Stopped."))">Stop</button>
    <button @onclick="@(() => Run(() => SpeechBridge.GetVoicesAsync(), Json.IReadOnlyListSpeechVoice))">Voices</button>
</div>

<h2>Recognition</h2>
<div class="actions">
    <button @onclick="@(() => Run(() => SpeechBridge.GetStatusAsync(), Json.SpeechStatus))">Status</button>
    <button @onclick="@(() => Run(() => SpeechBridge.RequestAccessAsync(), Json.SpeechAccessResult))">Request access</button>
    <button @onclick="@(() => Run(() => SpeechBridge.RecognizeAsync(new RecognizeRequest(SilenceTimeoutMs: 2000)), Json.RecognizeResult))" disabled="@Busy">Recognize once</button>
    <button @onclick="@(() => Run(() => SpeechBridge.StartListenerAsync(new SpeechListenerRequest()), Json.SpeechListener))">Start dictation</button>
    <button @onclick="@(() => Run(() => SpeechBridge.StopListenerAsync(), "Stopped."))">Stop dictation</button>
</div>

@if (partial is not null)
{
    <p class="muted">@partial…</p>
}

<Output Value="@Output" Error="@Error" />
<pre class="log">@log</pre>

@code {
    static SpeechJsonContext Json => SpeechJsonContext.Default;

    string text = "Hello from the web app.";
    string? partial;
    string log = String.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Listen<SpeechRecognized>(SpeechBridge.OnPartialAsync, e => partial = e.Text);

        await Listen<SpeechRecognized>(SpeechBridge.OnResultAsync, e =>
        {
            partial = null;
            Log("heard", e.Text);
        });

        await Listen<SpeechKeyword>(SpeechBridge.OnKeywordAsync, e => Log("speech.keyword", e.Keyword));
        await Listen<SpeechEnded>(SpeechBridge.OnEndedAsync, e =>
        {
            partial = null;
            Log("speech.ended", e.Reason.ToString());
        });
        await Listen<SpeakResult>(SpeechBridge.OnSpokenAsync, e => Log("speech.spoken", e.Completed ? "completed" : "interrupted"));
        await Listen<SpeechError>(SpeechBridge.OnErrorAsync, e => Log("speech.error", $"{e.Source}: {e.Message}"));
    }

    void Log(string name, string detail) => log = Prepend(log, $"{DateTime.Now:T}  {name}  {detail}");

    // Returns as soon as speech starts; OnSpokenAsync says when it finished.
    Task Speak() => Run(() => SpeechBridge.SpeakAsync(new SpeakRequest(text, Wait: false)), "Speaking.");
}
