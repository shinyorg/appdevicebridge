@page "/wifi"
@inherits BridgePage
@inject IWifiBridge WifiBridge

<h1>Wi-Fi</h1>

<div class="actions">
    <button @onclick="@(() => Run(() => WifiBridge.GetStatusAsync(), Json.WifiStatus))">Capabilities</button>
    <button @onclick="@(() => Run(() => WifiBridge.RequestAccessAsync(), Json.WifiAccessResult))">Request access</button>
    <button @onclick="@(() => Run(() => WifiBridge.GetCurrentNetworkAsync(), Json.WifiNetworkInfo))">Current network</button>
    <button @onclick="@(() => Run(() => WifiBridge.ScanAsync(), Json.IReadOnlyListWifiScanResult))">Scan</button>
    <button @onclick="@(() => Run(() => WifiBridge.GetKnownNetworksAsync(), Json.IReadOnlyListKnownWifiNetwork))">Known networks</button>
    <button @onclick="@(() => Run(() => WifiBridge.GetRadioAsync(), Json.WifiRadioState))">Radio</button>
</div>

<h2>Join a network</h2>
<div class="form">
    <input @bind="ssid" placeholder="SSID" />
    <input @bind="passphrase" placeholder="Passphrase" type="password" />
    <button @onclick="Join">Join</button>
</div>

<Output Value="@Output" Error="@Error" />

@code {
    static WifiJsonContext Json => WifiJsonContext.Default;

    string ssid = String.Empty;
    string passphrase = String.Empty;

    protected override Task OnInitializedAsync()
        => Listen<WifiChangedEvent>(WifiBridge.OnChangedAsync, e => Output = Compact(e, Json.WifiChangedEvent));

    Task Join() => Run(() => WifiBridge.ConnectAsync(new WifiConnectRequest
    {
        Ssid = ssid,
        Passphrase = passphrase.Length > 0 ? passphrase : null
    }), Json.WifiNetworkInfo);
}
