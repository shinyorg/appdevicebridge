@page "/contacts"
@inherits BridgePage
@inject IContactsBridge ContactsBridge

<h1>Contacts</h1>
<p class="muted">Android and iOS. Photos come from <code>GetPhotoAsync</code>, not the JSON.</p>

<div class="actions">
    <button @onclick="@(() => Run(() => ContactsBridge.GetAccessAsync(), Json.ContactsAccessResult))">Access status</button>
    <button @onclick="@(() => Run(() => ContactsBridge.RequestAccessAsync(), Json.ContactsAccessResult))">Request access</button>
</div>

<div class="form">
    <input @bind="search" placeholder="search name, phone or email" />
</div>
<div class="actions">
    <button @onclick="@(() => Load(0))">Search</button>
    <button disabled="@(offset == 0)" @onclick="@(() => Load(Math.Max(0, offset - PageSize)))">Previous page</button>
    <button disabled="@(!hasMore)" @onclick="@(() => Load(offset + PageSize))">Next page</button>
</div>

<ul>
    @foreach (var contact in contacts)
    {
        <li><a href="" @onclick="@(() => Run(() => ContactsBridge.GetContactAsync(contact.Id!), Json.Contact))" @onclick:preventDefault>@contact.DisplayName</a></li>
    }
</ul>

<div class="actions">
    <button @onclick="CreateSample">Create a sample contact</button>
    <button disabled="@(createdId is null)" @onclick="DeleteSample">Delete the sample contact</button>
</div>

<Output Value="@Output" Error="@Error" />

@code {
    const int PageSize = 20;

    static ContactsJsonContext Json => ContactsJsonContext.Default;

    string search = String.Empty;
    int offset;
    bool hasMore;
    string? createdId;
    IReadOnlyList<Contact> contacts = [];

    Task Load(int from) => Run(async () =>
    {
        var page = await ContactsBridge.GetContactsAsync(search, from, PageSize);
        offset = from;
        hasMore = page.HasMore;
        contacts = page.Items;
        return page;
    }, Json.ContactPage);

    Task CreateSample() => Run(async () =>
    {
        var created = await ContactsBridge.CreateContactAsync(new ContactInput
        {
            GivenName = "Sample",
            FamilyName = $"AppDeviceBridge {DateTime.Now:HHmmss}",
            Organization = new ContactOrganization(Company: "Shiny"),
            Phones = [new ContactPhone("555-0100", PhoneType.Mobile)],
            Emails = [new ContactEmail("sample@example.com", EmailType.Work)]
        });

        createdId = created.Id;
        return created;
    }, Json.ContactCreated);

    Task DeleteSample() => Run(async () =>
    {
        await ContactsBridge.DeleteContactAsync(createdId!);
        createdId = null;
    }, "Deleted.");
}
