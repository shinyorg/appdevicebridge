@page "/obd"
@inherits BridgePage
@inject IObdBridge ObdBridge

<h1>OBD-II</h1>
<p class="muted">Needs an ELM327 or OBDLink adapter plugged into a vehicle: Bluetooth LE, or Wi-Fi with this device joined to the adapter's network. The Shiny.Obd emulator stands in for a car.</p>

<div class="actions">
    <button @onclick="@(() => Run(() => ObdBridge.GetStatusAsync(), Json.ObdStatus))">Status</button>
    <button @onclick="@(() => Scan(ObdTransport.Ble))">Scan Bluetooth</button>
    <button @onclick="@(() => Scan(ObdTransport.Wifi))">Find Wi-Fi adapter</button>
    <button @onclick="@(() => Run(() => ObdBridge.DisconnectAsync(), "Disconnected."))">Disconnect</button>
</div>

<div class="actions">
    <input @bind="host" placeholder="192.168.0.10" />
    <input @bind="port" placeholder="35000" type="number" />
    <button @onclick="@(() => Run(() => ObdBridge.ConnectAsync(new ObdConnectRequest(ObdTransport.Wifi, Host: host, Port: port)), Json.ObdStatus))">Connect Wi-Fi</button>
</div>

<ul class="list">
    @foreach (var adapter in adapters)
    {
        <li>
            <strong>@adapter.Name</strong> <span class="muted">@adapter.Transport · @adapter.Id</span>
            <button @onclick="() => Connect(adapter)">Connect</button>
        </li>
    }
</ul>

<div class="actions">
    <button @onclick="@(() => Read("engineRpm"))">RPM</button>
    <button @onclick="@(() => Read("vehicleSpeed"))">Speed</button>
    <button @onclick="@(() => Read("coolantTemperature"))">Coolant</button>
    <button @onclick="@(() => Run(() => ObdBridge.GetVinAsync(), Json.ObdVin))">VIN</button>
    <button @onclick="@(() => Run(() => ObdBridge.GetTroubleCodesAsync(), Json.ObdTroubleCodes))">Trouble codes</button>
    <button @onclick="StartMonitor">Start monitor</button>
    <button @onclick="@(() => Run(() => ObdBridge.StopMonitorAsync(), "Stopped."))">Stop monitor</button>
</div>

<Output Value="@Output" Error="@Error" />
<pre class="log">@log</pre>

@code {
    static ObdJsonContext Json => ObdJsonContext.Default;

    IReadOnlyList<ObdAdapter> adapters = [];
    string host = "192.168.0.10";
    int port = 35000;
    string log = String.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Listen<ObdMonitorReading>(ObdBridge.OnReadingAsync, e => log = Prepend(log, $"{DateTime.Now:T}  {e.Command}  {Reading(e)}"));
        await Listen<ObdDisconnected>(ObdBridge.OnDisconnectedAsync, e => log = Prepend(log, $"{DateTime.Now:T}  disconnected  {e.Reason}"));
    }

    static string Reading(ObdMonitorReading e)
        => e.Error ?? (e.Value is { } value ? $"{value:0.##} {e.Unit}" : e.Text ?? "(none)");

    Task Scan(ObdTransport transport) => Run(async () =>
    {
        adapters = [];
        return adapters = await ObdBridge.ScanAsync(new ObdScanRequest(transport, 5000));
    }, Json.IReadOnlyListObdAdapter);

    Task Connect(ObdAdapter adapter) => Run(() => ObdBridge.ConnectAsync(adapter.Transport == ObdTransport.Ble
        ? new ObdConnectRequest(ObdTransport.Ble, PeripheralUuid: adapter.Id)
        : new ObdConnectRequest(ObdTransport.Wifi, Host: adapter.Host, Port: adapter.Port)), Json.ObdStatus);

    Task Read(string command) => Run(() => ObdBridge.ReadAsync(new ObdReadRequest(command)), Json.ObdReading);

    Task StartMonitor() => Run(() => ObdBridge.StartMonitorAsync(new ObdMonitorRequest(["engineRpm", "vehicleSpeed", "coolantTemperature"], 1000)), Json.ObdMonitor);
}
