@page "/notifications"
@inherits BridgePage
@inject INotificationsBridge NotificationsBridge

<h1>Notifications</h1>
<p class="muted">Tap a notification and <code>notification.entry</code> arrives here, or in background.js when the app is closed. Apple platforms also report notifications that arrive while the app is open.</p>

<div class="actions">
    <button @onclick="@(() => Run(() => NotificationsBridge.GetStatusAsync(), Json.NotificationStatus))">Status</button>
    <button @onclick="@(() => Run(() => NotificationsBridge.RequestAccessAsync(new NotificationAccessRequest(TimeSensitive: true)), Json.NotificationAccessResult))">Request access</button>
    <button @onclick="SendNow">Send now</button>
    <button @onclick="Schedule">Schedule in 10 s</button>
    <button @onclick="SendWithReply">Send with reply</button>
    <button @onclick="@(() => Run(() => NotificationsBridge.GetPendingAsync(), Json.IReadOnlyListPendingNotification))">Pending</button>
    <button @onclick="@(() => Run(() => NotificationsBridge.CancelAllAsync(), "Cancelled."))">Cancel all</button>
    <button @onclick="@(() => Run(() => NotificationsBridge.SetBadgeAsync(new NotificationBadge(3)), "Badge set."))">Badge 3</button>
    <button @onclick="@(() => Run(() => NotificationsBridge.SetBadgeAsync(new NotificationBadge(0)), "Badge cleared."))">Clear badge</button>
    <button @onclick="@(() => Run(() => NotificationsBridge.GetChannelsAsync(), Json.IReadOnlyListNotificationChannel))">Channels</button>
</div>

<Output Value="@Output" Error="@Error" />
<pre class="log">@log</pre>

@code {
    static NotificationsJsonContext Json => NotificationsJsonContext.Default;

    string log = String.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Listen<NotificationEvent>(NotificationsBridge.OnEntryAsync, e => Log("notification.entry", e));
        await Listen<NotificationEvent>(NotificationsBridge.OnReceivedAsync, e => Log("notification.received", e));
    }

    void Log(string name, NotificationEvent e) => log = Prepend(log, $"{DateTime.Now:T}  {name}  {Compact(e, Json.NotificationEvent)}");

    Task SendNow() => Run(() => NotificationsBridge.SendAsync(new NotificationRequest(
        $"Sent from the page at {DateTime.Now:T}",
        "AppDeviceBridge",
        Data: new Dictionary<string, string> { ["screen"] = "notifications" }
    )), Json.NotificationSent);

    Task Schedule() => Run(() => NotificationsBridge.SendAsync(new NotificationRequest(
        "Scheduled ten seconds ago",
        "AppDeviceBridge",
        ScheduleDate: DateTimeOffset.Now.AddSeconds(10)
    )), Json.NotificationSent);

    Task SendWithReply() => Run(async () =>
    {
        await NotificationsBridge.AddChannelAsync(new NotificationChannel(
            "sample-reply",
            Importance: ChannelImportance.High,
            Actions:
            [
                new NotificationChannelAction("reply", "Reply", ChannelActionType.TextReply),
                new NotificationChannelAction("dismiss", "Dismiss", ChannelActionType.Destructive)
            ]
        ));

        return await NotificationsBridge.SendAsync(new NotificationRequest("Long-press to reply", "AppDeviceBridge", Channel: "sample-reply"));
    }, Json.NotificationSent);
}
