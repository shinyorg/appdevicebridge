@page "/desktop"
@inherits BridgePage
@inject IAppBridge AppBridge
@inject ITrayBridge TrayBridge
@inject IQuickEntryBridge QuickEntry

<h1>Desktop</h1>
<p class="muted">Launch at login, the system tray and quick entry. All answer <code>501</code> on Android and iOS.</p>

<h2>Launch at login</h2>
<div class="actions">
    <button @onclick="@(() => Run(() => AppBridge.GetStartupAsync(), AppJson.StartupStatus))">State</button>
    <button @onclick="@(() => Run(() => AppBridge.RegisterStartupAsync(), AppJson.StartupStatus))">Register</button>
    <button @onclick="@(() => Run(() => AppBridge.UnregisterStartupAsync(), AppJson.StartupStatus))">Unregister</button>
    <button @onclick="@(() => Run(() => AppBridge.OpenStartupSettingsAsync(), AppJson.StartupSettingsResult))">Open OS settings</button>
</div>

<h2>Tray icon</h2>
<div class="form">
    <input @bind="tooltip" placeholder="Tooltip" />
    <input @bind="badge" placeholder="Badge, e.g. 3" />
</div>
<div class="actions">
    <button @onclick="@(() => Run(() => TrayBridge.GetStatusAsync(), Json.TrayStatus))">Status</button>
    <button @onclick="Show">Show with menu</button>
    <button @onclick="Update">Apply tooltip and badge</button>
    <button @onclick="Notify">Notify</button>
    <button @onclick="Animate">Animate</button>
    <button @onclick="@(() => Run(() => TrayBridge.StopAnimationAsync(TrayId), "Stopped."))">Stop animating</button>
    <button @onclick="@(() => Run(() => TrayBridge.RemoveAsync(TrayId), "Removed."))">Remove</button>
</div>

<h2>Clicks</h2>
<pre>@(clicks.Length == 0 ? "Click the tray icon or pick something from its menu." : clicks)</pre>

<h2>Quick entry</h2>
<p class="muted">A prompt that opens over other applications. Press <kbd>Ctrl+Alt+Space</kbd> anywhere, or use the buttons. Submissions are answered by the page while it is open and by <code>background.js</code> when it is not.</p>
<div class="form">
    <input @bind="placeholder" placeholder="Placeholder" />
</div>
<div class="actions">
    <button @onclick="@(() => Run(() => QuickEntry.GetStatusAsync(), QuickJson.QuickEntryStatus))">Status</button>
    <button @onclick="Configure">Set prompt and suggestions</button>
    <button @onclick="@(() => Run(() => QuickEntry.ShowAsync(), QuickJson.QuickEntryStatus))">Show</button>
    <button @onclick="@(() => Run(() => QuickEntry.HideAsync(), QuickJson.QuickEntryStatus))">Hide</button>
    <button @onclick="@(() => Run(() => QuickEntry.ConfigureAsync(new QuickEntryOptionsInput(Placement: QuickEntryPlacement.BottomCenter)), QuickJson.QuickEntryStatus))">Move to bottom</button>
    <button @onclick="@(() => Run(() => QuickEntry.PulseGlowAsync(new QuickEntryPulse(1500)), "Pulsed."))">Pulse glow</button>
    <button @onclick="@(() => Run(() => QuickEntry.ResetPromptAsync(), QuickJson.QuickEntryPrompt))">Reset</button>
</div>

<h2>Quick entry activity</h2>
<pre>@(entries.Length == 0 ? "Open quick entry and submit something." : entries)</pre>

<Output Value="@Output" Error="@Error" />

@code {
    static TrayJsonContext Json => TrayJsonContext.Default;
    static AppJsonContext AppJson => AppJsonContext.Default;
    static QuickEntryJsonContext QuickJson => QuickEntryJsonContext.Default;

    // PUT rather than POST, so a hot reload adopts the icon it made last time instead of adding another.
    const string TrayId = "main";

    // A 22x22 template image: black with an alpha channel, which macOS and Linux tint for the menu bar.
    const string Dot = "iVBORw0KGgoAAAANSUhEUgAAABYAAAAWCAYAAADEtGw7AAAAWElEQVR42mNgIA70oGGKQA+RmCxD/xPARBtOrIEkW0COociGU91QnIb3UNHgHmq7FquraWJwDw0M7hk1GCNlDK1UQdMMQrMsTdNCiKbFJs0KeppXTRRXpgB3d0Dso2MAxAAAAABJRU5ErkJggg==";
    const string Ring = "iVBORw0KGgoAAAANSUhEUgAAABYAAAAWCAYAAADEtGw7AAAAZklEQVR42u2VwQoAIAhD+3/2z3WLENRp7ZbgLV+xpY7BBUxeBchsQWeSNJwFli/oQE/4c6gLjyTwTKMkQVG7DB6CM0MQ1HEHimbvB30wrM7PzZN/N0mDyFpaOoSkY1M26OWr6XqZLuDH/OUlvt1/AAAAAElFTkSuQmCC";

    string tooltip = "AppDeviceBridge Sample";
    string badge = String.Empty;
    string clicks = String.Empty;
    string placeholder = "Ask the sample anything…";
    string entries = String.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Listen<TrayClick>(TrayBridge.OnClickAsync, e => clicks = Prepend(clicks, $"{DateTime.Now:T}  click  {Compact(e, Json.TrayClick)}"));
        await Listen<TrayMenuSelection>(TrayBridge.OnMenuAsync, e => clicks = Prepend(clicks, $"{DateTime.Now:T}  menu   {Compact(e, Json.TrayMenuSelection)}"));

        await Listen<QuickEntrySubmission>(QuickEntry.OnSubmittedAsync, e => entries = Prepend(entries, $"{DateTime.Now:T}  submitted  {Compact(e, QuickJson.QuickEntrySubmission)}"));
        await Listen<QuickEntryPromptEvent>(QuickEntry.OnCancelledAsync, e => entries = Prepend(entries, $"{DateTime.Now:T}  cancelled  {e.Text}"));
        await Listen<QuickEntryStatus>(QuickEntry.OnOpenedAsync, _ => entries = Prepend(entries, $"{DateTime.Now:T}  opened"));
        await Listen<QuickEntryStatus>(QuickEntry.OnClosedAsync, _ => entries = Prepend(entries, $"{DateTime.Now:T}  closed"));
    }

    Task Show() => Run(() => TrayBridge.PutAsync(TrayId, new TrayIconInput(
        Tooltip: tooltip,
        TemplateImage: true,
        Icon: new TrayImage(Data: Dot),
        Menu: new TrayMenuInput(
        [
            new TrayMenuItemInput("open", Label: "Open the app"),
            new TrayMenuItemInput("sync", Label: "Sync now", Accelerator: "Ctrl+S"),
            new TrayMenuItemInput(Type: TrayMenuItemType.Separator),
            new TrayMenuItemInput("notify", TrayMenuItemType.Check, "Notifications", Checked: true),
            new TrayMenuItemInput(Type: TrayMenuItemType.Submenu, Label: "More", Items:
            [
                new TrayMenuItemInput("about", Label: "About"),
                new TrayMenuItemInput("quit", Label: "Quit")
            ])
        ])
    )), Json.TrayIconInfo);

    Task Configure() => Run(() => QuickEntry.SetPromptAsync(new QuickEntryPromptInput(
        Placeholder: placeholder,
        Response: String.Empty,
        Suggestions:
        [
            new QuickEntrySuggestion("What's the battery level?", "Answered by the page", "🔋", Value: "battery"),
            new QuickEntrySuggestion("Sync now", "Runs the sync job", "🔄", Value: "sync"),
            new QuickEntrySuggestion("Open the app", Glyph: "🪟", Value: "open")
        ]
    )), QuickJson.QuickEntryPrompt);

    // Only what is set changes, and an empty string clears a value.
    Task Update() => Run(() => TrayBridge.PutAsync(TrayId, new TrayIconInput(Tooltip: tooltip, Badge: badge)), Json.TrayIconInfo);

    Task Notify() => Run(() => TrayBridge.NotifyAsync(TrayId, new TrayNotification("AppDeviceBridge", "Sent from the page, shown by the tray.")), "Notified.");

    Task Animate() => Run(() => TrayBridge.StartAnimationAsync(TrayId, new TrayAnimation([new TrayImage(Data: Dot), new TrayImage(Data: Ring)], 400)), Json.TrayIconInfo);
}
