@page "/location"
@inherits BridgePage
@inject IGpsBridge GpsBridge
@inject IGeofencesBridge GeofencesBridge
@inject IMotionBridge MotionBridge

<h1>Location</h1>

<h2>GPS</h2>
<div class="actions">
    <button @onclick="Current">Current position</button>
    <button @onclick="StartListening">Listen (background)</button>
    <button @onclick="@(() => Run(() => GpsBridge.StopListenerAsync(), "Stopped."))">Stop</button>
</div>

<h2>Geofences</h2>
<div class="actions">
    <button @onclick="WatchHere">Watch 200 m around me</button>
    <button @onclick="@(() => Run(() => GeofencesBridge.GetRegionsAsync(), Json.IReadOnlyListGeofenceRegion))">Regions</button>
    <button @onclick="@(() => Run(() => GeofencesBridge.StopAllMonitoringAsync(), "Cleared."))">Clear</button>
</div>

<h2>Motion activity</h2>
<p class="muted">Needs AddMotionActivityBridge(). Readings that arrive in the background go to the motion handler.</p>
<div class="actions">
    <button @onclick="CurrentActivity">Current activity</button>
    <button @onclick="ListenForActivity">Listen</button>
    <button @onclick="@(() => Run(() => MotionBridge.StopListenerAsync(), "Stopped."))">Stop</button>
</div>

<Output Value="@Output" Error="@Error" />

@code {
    static LocationsJsonContext Json => LocationsJsonContext.Default;

    // Standard background mode: readings keep arriving with the app in the background, where they go to the gps
    // handler — this page's if it is open, background.js's if not.
    static readonly GpsListenerSettings Background = new(GpsBackgroundMode.Standard);

    protected override async Task OnInitializedAsync()
    {
        await Listen<GpsReading>(GpsBridge.OnReadingAsync, e => Output = Compact(e, Json.GpsReading));
        await Listen<MotionActivity>(MotionBridge.OnActivityAsync, e => Output = Compact(e, Json.MotionActivity));
    }

    Task CurrentActivity() => Run(async () =>
    {
        await MotionBridge.RequestAccessAsync();
        return await MotionBridge.GetCurrentAsync();
    }, Json.MotionActivity);

    Task ListenForActivity() => Run(async () =>
    {
        await MotionBridge.RequestAccessAsync();
        await MotionBridge.StartListenerAsync();
        return await MotionBridge.GetListenerAsync();
    }, Json.MotionListener);

    Task Current() => Run(async () =>
    {
        await GpsBridge.RequestAccessAsync(new GpsListenerSettings());
        return await GpsBridge.GetCurrentPositionAsync();
    }, Json.GpsReading);

    Task StartListening() => Run(async () =>
    {
        await GpsBridge.RequestAccessAsync(Background);
        await GpsBridge.StartListenerAsync(Background);
        return await GpsBridge.GetListenerAsync();
    }, Json.GpsListenerSettings);

    Task WatchHere() => Run(async () =>
    {
        await GpsBridge.RequestAccessAsync(new GpsListenerSettings());
        await GeofencesBridge.RequestAccessAsync();

        var here = await GpsBridge.GetCurrentPositionAsync() ?? throw new InvalidOperationException("No position yet.");
        await GeofencesBridge.StartMonitoringAsync(new GeofenceRegion("sample-here", here.Latitude, here.Longitude, 200));

        return await GeofencesBridge.GetRegionsAsync();
    }, Json.IReadOnlyListGeofenceRegion);
}
