@page "/"
@inherits BridgePage
@inject IHostBridge HostBridge
@inject NavigationManager Navigation

<h1>AppDeviceBridge + Blazor</h1>

@if (host is { } h)
{
    <p class="muted">web app @h.WebAppVersion (@h.WebAppOrigin) · host @h.HostVersion · @h.Platform</p>

    @if (h.DevServer is { } dev)
    {
        <p class="banner">Pages from dotnet watch at @dev — edit Sample.Blazor and save.</p>
    }

    @if (h.PendingVersion is { } pending)
    {
        <div class="banner">Version @pending is ready. <button @onclick="ApplyUpdate">Reload now</button></div>
    }

    <h2>Bridges</h2>
    <ul class="chips">
        @foreach (var bridge in h.Bridges)
        {
            <li class="@(bridge.IsSupported ? "" : "unsupported")">@bridge.Name</li>
        }
    </ul>
}

<Output Error="@Error" />

<h2>Live events</h2>
<pre class="log">@log</pre>

@code {
    // Raw events, for a page that only shows what arrives. Each bridge's typed client has the same events, typed.
    static readonly string[] EventNames =
    [
        "app.orientation", "app.culture", "app.timezone", "gps.reading", "geofence.status", "ble.status", "ble.error",
        "wifi.changed", "push.token", "push.received", "push.entry", "discovery.error", "discovery.stopped"
    ];

    HostInfo? host;
    string log = String.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Run(async () => host = await HostBridge.GetInfoAsync(), "Loaded.");
        Output = null;

        foreach (var name in EventNames)
            await Listen(name, e => log = Prepend(log, $"{DateTime.Now:T}  {name}  {e.GetRawText()}"));
    }

    async Task ApplyUpdate()
    {
        if ((await HostBridge.ApplyUpdateAsync()).Applied)
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }
}
