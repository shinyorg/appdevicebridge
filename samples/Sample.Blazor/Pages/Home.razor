@page "/"
@inherits BridgePage
@inject NavigationManager Navigation

<h1>WebAppHost + Blazor</h1>

@if (host is { } h)
{
    <p class="muted">web app @Text(h, "webAppVersion") (@Text(h, "webAppOrigin")) · host @Text(h, "hostVersion") · @Text(h, "platform")</p>

    @if (Text(h, "devServer") is { } dev)
    {
        <p class="banner">Pages from dotnet watch at @dev — edit Sample.Blazor and save.</p>
    }

    @if (Text(h, "pendingVersion") is { } pending)
    {
        <div class="banner">Version @pending is ready. <button @onclick="ApplyUpdate">Reload now</button></div>
    }

    <h2>Bridges</h2>
    <ul class="chips">
        @foreach (var bridge in h.GetProperty("bridges").EnumerateArray())
        {
            <li class="@(bridge.GetProperty("isSupported").GetBoolean() ? "" : "unsupported")">@bridge.GetProperty("name").GetString()</li>
        }
    </ul>
}

<Output Error="@Error" />

<h2>Live events</h2>
<pre class="log">@log</pre>

@code {
    static readonly string[] EventNames =
    [
        "app.orientation", "app.culture", "app.timezone", "gps.reading", "geofence.status", "ble.status", "ble.error",
        "wifi.changed", "push.token", "push.received", "push.entry", "discovery.error", "discovery.stopped"
    ];

    JsonElement? host;
    string log = String.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Run(async () => host = await Bridge.GetAsync("host"));

        foreach (var name in EventNames)
            await Listen(name, e => log = Prepend(log, $"{DateTime.Now:T}  {name}  {e.GetRawText()}"));
    }

    async Task ApplyUpdate()
    {
        if (await Bridge.PostAsync("host/apply-update") is { } result && result.GetProperty("applied").GetBoolean())
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }
}
