@page "/discovery"
@inherits BridgePage
@inject IDiscoveryBridge DiscoveryBridge

<h1>Discovery</h1>

<h2>mDNS / Bonjour</h2>
<div class="form">
    <input @bind="serviceType" placeholder="_http._tcp" />
    <button @onclick="@(() => Run(() => DiscoveryBridge.SearchMdnsAsync(new MdnsSearchRequest(serviceType, ScanMs: 4000)), Json.IReadOnlyListMdnsService))">Search</button>
    <button @onclick="@(() => Run(() => DiscoveryBridge.BrowseMdnsAsync(new MdnsSearchRequest(serviceType)), Json.DiscoveryBrowse))">Browse</button>
    <button @onclick="PublishSelf">Advertise this app</button>
</div>

<h2>SSDP and WS-Discovery</h2>
<div class="actions">
    <button @onclick="@(() => Run(() => DiscoveryBridge.SearchSsdpAsync(new SsdpSearchRequest("ssdp:all")), Json.IReadOnlyListSsdpDevice))">UPnP devices</button>
    <button @onclick="OnvifCameras">ONVIF cameras</button>
    <button @onclick="@(() => Run(() => DiscoveryBridge.GetPublicationsAsync(), Json.IReadOnlyListDiscoveryPublication))">Publications</button>
    <button @onclick="StopBrowsing">Stop browsing</button>
</div>

<Output Value="@Output" Error="@Error" />
<pre class="log">@log</pre>

@code {
    static DiscoveryJsonContext Json => DiscoveryJsonContext.Default;

    string serviceType = "_http._tcp";
    string log = String.Empty;

    protected override Task OnInitializedAsync() => Listen<MdnsBrowseResult>(DiscoveryBridge.OnMdnsAsync, e =>
        log = Prepend(log, $"{e.Status}  {e.Service.FullName}  {e.Service.Port}"));

    // iOS only lets the app advertise and browse types listed in NSBonjourServices; the sample lists this one.
    Task PublishSelf() => Run(() => DiscoveryBridge.PublishMdnsAsync(new MdnsPublishRequest(
        "AppDeviceBridge Sample",
        "_appdevicebridge._tcp",
        5780,
        TxtRecords: new Dictionary<string, string> { ["app"] = "sample" }
    )), Json.DiscoveryPublication);

    Task OnvifCameras() => Run(() => DiscoveryBridge.SearchWsdAsync(new WsdSearchRequest(
        Types: [new WsdQualifiedName("NetworkVideoTransmitter", "http://www.onvif.org/ver10/network/wsdl")]
    )), Json.IReadOnlyListWsdTarget);

    Task StopBrowsing() => Run(async () =>
    {
        foreach (var browse in await DiscoveryBridge.GetBrowsesAsync())
            await DiscoveryBridge.StopBrowseAsync(browse.Id);

        return await DiscoveryBridge.GetBrowsesAsync();
    }, Json.IReadOnlyListDiscoveryBrowse);
}
