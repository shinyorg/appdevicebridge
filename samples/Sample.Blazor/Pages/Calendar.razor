@page "/calendar"
@inherits BridgePage
@inject ICalendarBridge CalendarBridge

<h1>Calendar</h1>
<p class="muted">Android, iOS, Mac Catalyst, macOS and Windows. Events are listed for a date range of at most 366 days.</p>

<div class="actions">
    <button @onclick="@(() => Run(() => CalendarBridge.GetAccessAsync(), Json.CalendarAccessResult))">Access status</button>
    <button @onclick="@(() => Run(() => CalendarBridge.RequestAccessAsync(new()), Json.CalendarAccessResult))">Request access</button>
    <button @onclick="@(() => Run(() => CalendarBridge.GetCalendarsAsync(), Json.CalendarList))">Calendars</button>
</div>

<div class="form">
    <input @bind="search" placeholder="title contains" />
</div>
<div class="actions">
    <button @onclick="@(() => Load(0))">Next 30 days</button>
    <button disabled="@(offset == 0)" @onclick="@(() => Load(Math.Max(0, offset - PageSize)))">Previous page</button>
    <button disabled="@(!hasMore)" @onclick="@(() => Load(offset + PageSize))">Next page</button>
</div>

<div class="actions">
    <button @onclick="CreateSample">Create a sample event tomorrow</button>
    <button disabled="@(createdId is null)" @onclick="DeleteSample">Delete the sample event</button>
</div>

<Output Value="@Output" Error="@Error" />

@code {
    const int PageSize = 20;
    static CalendarJsonContext Json => CalendarJsonContext.Default;

    string search = String.Empty;
    int offset;
    bool hasMore;
    string? createdId;

    Task Load(int from) => Run(async () =>
    {
        var start = DateTimeOffset.Now;
        var page = await CalendarBridge.GetEventsAsync(
            start,
            start.AddDays(30),
            search: search.Length > 0 ? search : null,
            offset: from,
            limit: PageSize
        );

        offset = from;
        hasMore = page.HasMore;
        return page;
    }, Json.CalendarEventPage);

    Task CreateSample() => Run(async () =>
    {
        var start = new DateTimeOffset(DateTime.Today.AddDays(1).AddHours(10));
        var created = await CalendarBridge.CreateEventAsync(new NewCalendarEvent
        {
            Title = "AppDeviceBridge sample",
            Description = "Created from the sample web app.",
            Location = "Room 3",
            Start = start,
            End = start.AddMinutes(30),
            ReminderMinutes = [15]
        });

        createdId = created.Id;
        return created;
    }, Json.CalendarEvent);

    Task DeleteSample() => Run(async () =>
    {
        await CalendarBridge.DeleteEventAsync(createdId!);
        createdId = null;
    }, "Deleted.");
}
