@page "/transfers"
@inherits BridgePage
@inject ITransfersBridge TransfersBridge
@inject IFilesBridge FilesBridge

<h1>Transfers</h1>
<p class="muted">Background uploads and downloads that keep going when the app is suspended. Completion and failure also reach background.js.</p>

<h2>Download <span class="muted">(into cache)</span></h2>
<div class="form">
    <input @bind="downloadUrl" placeholder="https://…" />
    <input @bind="downloadPath" placeholder="downloads/file.bin" />
</div>
<div class="actions">
    <button @onclick="Download">Download</button>
</div>

<h2>Upload <span class="muted">(from data)</span></h2>
<div class="form">
    <input @bind="uploadUrl" placeholder="https://…" />
    <input @bind="uploadPath" placeholder="uploads/hello.txt" />
</div>
<div class="actions">
    <button @onclick="Upload">Write a file and upload it</button>
</div>

<h2>Queue</h2>
<div class="actions">
    <button @onclick="Refresh">List</button>
    <button @onclick="@(() => Run(() => TransfersBridge.CancelAllAsync(), "Cancelled."))">Cancel all</button>
</div>

<ul class="list">
    @foreach (var transfer in live.Values.OrderBy(x => x.Id))
    {
        <li>
            <strong>@transfer.Type</strong> @transfer.Path — @transfer.Status @(transfer.PercentComplete is { } p ? p.ToString("P0") : "")
            <button @onclick="@(() => Run(() => TransfersBridge.CancelAsync(transfer.Id), "Cancelled."))">Cancel</button>
        </li>
    }
</ul>

<Output Value="@Output" Error="@Error" />
<pre class="log">@log</pre>

@code {
    static TransfersJsonContext Json => TransfersJsonContext.Default;

    // httpbin echoes what it is sent, and serves bytes of any size: enough to watch progress move.
    string downloadUrl = "https://httpbin.org/bytes/5242880";
    string downloadPath = "downloads/random.bin";
    string uploadUrl = "https://httpbin.org/post";
    string uploadPath = "uploads/hello.txt";
    string log = String.Empty;

    readonly Dictionary<string, TransferInfo> live = [];

    protected override async Task OnInitializedAsync()
    {
        await Listen<TransferInfo>(TransfersBridge.OnProgressAsync, e => live[e.Id] = e);
        await Listen<TransferInfo>(TransfersBridge.OnCompletedAsync, e => Finished("transfer.completed", e));
        await Listen<TransferInfo>(TransfersBridge.OnFailedAsync, e => Finished("transfer.failed", e));
        await Listen<TransferInfo>(TransfersBridge.OnCancelledAsync, e => Finished("transfer.cancelled", e));
    }

    void Finished(string name, TransferInfo transfer)
    {
        log = Prepend(log, $"{DateTime.Now:T}  {name}  {Compact(transfer, Json.TransferInfo)}");
        live.Remove(transfer.Id);
    }

    Task Download() => Run(async () =>
        Track(await TransfersBridge.QueueAsync(new TransferRequest(TransferType.Download, downloadUrl, "cache", downloadPath))),
        Json.TransferInfo);

    Task Upload() => Run(async () =>
    {
        await FilesBridge.WriteTextAsync("data", uploadPath, $"Uploaded from Blazor at {DateTime.Now:O}");

        return Track(await TransfersBridge.QueueAsync(new TransferRequest(
            TransferType.UploadMultipart,
            uploadUrl,
            "data",
            uploadPath,
            FormDataName: "file",
            Body: new TransferBody("""{ "from": "sample" }""", "application/json", "meta")
        )));
    }, Json.TransferInfo);

    Task Refresh() => Run(async () =>
    {
        var result = await TransfersBridge.GetTransfersAsync();
        live.Clear();

        foreach (var transfer in result.Transfers)
            Track(transfer);

        return result;
    }, Json.TransferList);

    TransferInfo Track(TransferInfo transfer) => live[transfer.Id] = transfer;
}
