@inherits LayoutComponentBase
@inject NativeCallHandlers Handlers

<div class="shell">
    <nav>
        <strong>WebAppHost</strong>
        <NavLink href="" Match="NavLinkMatch.All">Home</NavLink>
        <NavLink href="device">Device</NavLink>
        <NavLink href="location">Location</NavLink>
        <NavLink href="bluetooth">Bluetooth</NavLink>
        <NavLink href="wifi">Wi-Fi</NavLink>
        <NavLink href="discovery">Discovery</NavLink>
        <NavLink href="push">Push</NavLink>
        <NavLink href="storage">Storage</NavLink>
        <NavLink href="background">Background</NavLink>
    </nav>
    <main>
        @Body
    </main>
</div>

@code {
    // The handlers live for the whole page, not one screen: a job can arrive whatever the user is looking at.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await Handlers.StartAsync();
    }
}
