@inherits LayoutComponentBase
@implements IDisposable
@inject NativeCallHandlers Handlers
@inject IHostBridge HostBridge
@inject NavigationManager Navigation

<div class="app @(menuOpen ? "menu-open" : "")">
    <header class="topbar">
        <button class="icon-button" aria-label="Menu" @onclick="() => menuOpen = !menuOpen">
            <Icon Name="@(menuOpen ? "close" : "menu")" Size="22" />
        </button>
        <a class="brand" href="">
            <span class="brand-mark"><Icon Name="bolt" Size="16" /></span>
            AppDeviceBridge
        </a>
        @if (host is { } h)
        {
            <span class="platform-pill">@h.Platform</span>
        }
    </header>

    <aside class="sidebar">
        <a class="brand sidebar-brand" href="">
            <span class="brand-mark"><Icon Name="bolt" Size="16" /></span>
            <span>
                AppDeviceBridge
                <small>Blazor sample</small>
            </span>
        </a>

        <nav>
            @foreach (var group in SampleNav.Groups)
            {
                <div class="nav-group">
                    <div class="nav-title">@group.Title</div>
                    @foreach (var item in group.Items)
                    {
                        <NavLink href="@item.Route" Match="@(item.Route.Length == 0 ? NavLinkMatch.All : NavLinkMatch.Prefix)" class="nav-item">
                            <Icon Name="@item.Icon" />
                            <span>@item.Label</span>
                        </NavLink>
                    }
                </div>
            }
        </nav>

        @if (host is { } info)
        {
            <div class="sidebar-foot">
                <span class="dot"></span>
                <span>@info.AppId · @info.Platform</span>
            </div>
        }
    </aside>

    <div class="scrim" @onclick="() => menuOpen = false"></div>

    <main>
        <article class="page">
            @Body
        </article>
    </main>
</div>

@code {
    HostInfo? host;
    bool menuOpen;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;

        try
        {
            host = await HostBridge.GetInfoAsync();
        }
        catch (Exception)
        {
            // The pages report their own failures; the shell only decorates with what it can get.
        }
    }

    // The handlers live for the whole page, not one screen: a job can arrive whatever the user is looking at.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await Handlers.StartAsync();
    }

    void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (!menuOpen)
            return;

        menuOpen = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
