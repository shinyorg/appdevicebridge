<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- Plain HTTP to 127.0.0.1, where the web app is served. Required by every Shiny.AppDeviceBridge app. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- Discovery bridge: iOS only browses and advertises the service types listed here. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>The sample web app finds and advertises services, and OBD adapters, on your local network.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_http._tcp</string>
		<string>_appdevicebridge._tcp</string>
	</array>

	<key>NSLocationWhenInUseUsageDescription</key>
	<string>The sample web app shows your position.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>The sample web app watches geofences around you.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>The sample web app scans for Bluetooth LE devices.</string>
	<!-- Shiny.Jobs schedules web app jobs under these, one per charging/network combination. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.shiny.job</string>
		<string>com.shiny.jobnet</string>
		<string>com.shiny.jobpower</string>
		<string>com.shiny.jobpowernet</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>bluetooth-central</string>
		<string>processing</string>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>

	<!-- WebView camera and microphone (AllowWebPermissions), and the Speech bridge -->
	<key>NSCameraUsageDescription</key>
	<string>The sample web app shows the camera and takes photos.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>The sample web app shows a microphone level and recognizes speech.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>The sample web app turns what you say into text.</string>

	<!-- Motion activity bridge: the permission request terminates the app without this -->
	<key>NSMotionUsageDescription</key>
	<string>The sample web app shows whether you are walking, running, cycling or driving.</string>

	<!-- Health bridge -->
	<key>NSHealthShareUsageDescription</key>
	<string>The sample web app reads your steps and heart rate.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>The sample web app can log health samples you enter.</string>

	<!-- Contacts bridge -->
	<key>NSContactsUsageDescription</key>
	<string>The sample web app lists, adds and removes contacts.</string>

	<!-- Calendar bridge -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>The web app browses your photo library when you ask it to.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>The sample web app lists, adds and removes calendar events.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>The sample web app adds events to your calendar.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>The sample web app lists, adds and removes calendar events.</string>

	<!-- App links bridge: sample://… -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>org.shinylib.appdevicebridge.sample</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sample</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
