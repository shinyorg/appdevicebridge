<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <MauiVersion>10.0.101</MauiVersion>
        <MauiLabsVersion>0.1.0-preview.12.26421.1</MauiLabsVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="GirCore.Gtk-4.0" Version="0.8.1"/>
        <PackageVersion Include="Nerdbank.GitVersioning" Version="3.10.91"/>
        <PackageVersion Include="Shiny.Net.HttpServer" Version="1.2.2"/>
        <PackageVersion Include="Shiny.Net.HttpServer.Ssh" Version="1.2.2"/>
        <PackageVersion Include="Shiny.Net.HttpServer.Mcp" Version="1.2.2"/>
        <PackageVersion Include="Jint" Version="4.16.2"/>
        <PackageVersion Include="XenoAtom.Terminal.UI" Version="3.8.1"/>
        <PackageVersion Include="Shiny.Extensions.MauiHosting" Version="5.2.1"/>
        <PackageVersion Include="Shiny.Extensions.Stores" Version="5.2.1"/>
        <PackageVersion Include="Shiny.Maui.Controls.Desktop" Version="1.4.0"/>
        <PackageVersion Include="Shiny.Maui.Controls.Camera" Version="1.4.0"/>
        <PackageVersion Include="Shiny.Hosting.Maui" Version="5.8.0-beta-0001"/>
        <PackageVersion Include="Shiny.Jobs" Version="5.8.0-beta-0001"/>
        <PackageVersion Include="Shiny.Push" Version="5.8.0-beta-0001"/>
        <PackageVersion Include="Shiny.Notifications" Version="5.8.0-beta-0001"/>
        <PackageVersion Include="Shiny.Wearables" Version="5.8.0-beta-0001"/>
        <PackageVersion Include="Shiny.Notifications.Linux" Version="5.8.0-beta-0001"/>
        <PackageVersion Include="Shiny.Net.Wifi" Version="5.8.0-beta-0001"/>
        <PackageVersion Include="Shiny.Net.Wifi.Linux" Version="5.8.0-beta-0001"/>
        <PackageVersion Include="Shiny.Net.Discovery" Version="5.8.0-beta-0001"/>
        <PackageVersion Include="Shiny.Obd" Version="1.2.0"/>
        <PackageVersion Include="Shiny.Obd.Ble" Version="1.2.0"/>
        <PackageVersion Include="Shiny.Obd.Wifi" Version="1.2.0"/>
        <PackageVersion Include="Shiny.Locations" Version="5.8.0-beta-0001"/>
        <PackageVersion Include="Shiny.BluetoothLE" Version="5.8.0-beta-0001"/>
        <PackageVersion Include="Shiny.Health" Version="2.0.1"/>
        <PackageVersion Include="Shiny.Contacts" Version="5.8.0-beta-0001"/>
        <PackageVersion Include="Shiny.Calendar" Version="5.8.0-beta-0001"/>
        <PackageVersion Include="Shiny.Speech" Version="3.0.0-beta-0030"/>
        <PackageVersion Include="Shiny.ScreenRecorder" Version="5.8.0-beta-0001"/>
        <PackageVersion Include="Shiny.ScreenRecorder.Linux" Version="5.8.0-beta-0001"/>
        <PackageVersion Include="Shiny.Net.Http" Version="5.8.0-beta-0001"/>
        <PackageVersion Include="Shiny.Core.Linux" Version="5.8.0-beta-0001"/>
        <PackageVersion Include="Xamarin.AndroidX.DocumentFile" Version="1.1.0.3"/>
        <PackageVersion Include="GirCore.Gtk-4.0" Version="0.7.0"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0"/>
        <PackageVersion Include="PolySharp" Version="1.16.0"/>
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12"/>
        <PackageVersion Include="Microsoft.Maui.Controls" Version="$(MauiVersion)"/>
        <PackageVersion Include="Tmds.DBus.Protocol" Version="0.94.1"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.MacOS" Version="$(MauiLabsVersion)"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.MacOS.Essentials" Version="$(MauiLabsVersion)"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.Linux.Gtk4" Version="$(MauiLabsVersion)"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.Linux.Gtk4.Essentials" Version="$(MauiLabsVersion)"/>
        <PackageVersion Include="Microsoft.Maui.DevFlow.Agent" Version="$(MauiLabsVersion)"/>
    </ItemGroup>
    <ItemGroup>
        <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.12"/>
        <PackageVersion Include="xunit.v3" Version="3.2.2"/>
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0"/>
        <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="1.9.1"/>
    </ItemGroup>
</Project>