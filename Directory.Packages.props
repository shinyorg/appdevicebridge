<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <MauiVersion>10.0.101</MauiVersion>
        <MauiLabsVersion>0.1.0-preview.12.26421.1</MauiLabsVersion>
        <ShinyVersion>5.9.0-beta-0009</ShinyVersion>
        <DocumentDbVersion>14.1.0-gdd7f615437</DocumentDbVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="GirCore.Gtk-4.0" Version="0.8.1"/>
        <PackageVersion Include="Nerdbank.GitVersioning" Version="3.10.91"/>
        <PackageVersion Include="Shiny.Net.HttpServer" Version="2.0.1"/>
        <PackageVersion Include="Shiny.Net.HttpServer.Ssh" Version="2.0.1"/>
        <PackageVersion Include="Shiny.Net.HttpServer.Mcp" Version="2.0.1"/>
        <PackageVersion Include="Jint" Version="4.16.2"/>
        <PackageVersion Include="XenoAtom.Terminal.UI" Version="3.8.1"/>
        <PackageVersion Include="Shiny.Extensions.MauiHosting" Version="5.3.1"/>
        <PackageVersion Include="Shiny.Extensions.Stores" Version="5.3.1"/>
        <PackageVersion Include="Shiny.Maui.Controls.Desktop" Version="1.5.0"/>
        <PackageVersion Include="Shiny.Maui.Controls.Camera" Version="1.5.0"/>
        <PackageVersion Include="Shiny.Hosting.Maui" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Jobs" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Push" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Notifications" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Wearables" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Mobile.LiveActivities" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Notifications.Linux" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Net.Wifi" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Net.Wifi.Linux" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Net.Discovery" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Obd" Version="1.3.0"/>
        <PackageVersion Include="Shiny.Obd.Ble" Version="1.3.0"/>
        <PackageVersion Include="Shiny.Obd.Wifi" Version="1.3.0"/>
        <PackageVersion Include="Shiny.Gps" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Geofencing" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.DocumentDb.Geofencing" Version="$(DocumentDbVersion)"/>
        <PackageVersion Include="Shiny.DocumentDb.Sqlite" Version="$(DocumentDbVersion)"/>
        <PackageVersion Include="Shiny.DocumentDb.Geo" Version="$(DocumentDbVersion)"/>
        <!-- Lifts Microsoft.Data.Sqlite's 2.1.11 (GHSA-2m69-gcr7-jv3q) in the sample's geo store. -->
        <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13"/>
        <PackageVersion Include="Shiny.BluetoothLE" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Beacons" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Health" Version="2.0.1"/>
        <PackageVersion Include="Shiny.Contacts" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Calendar" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Speech" Version="3.0.0-beta-0030"/>
        <PackageVersion Include="Shiny.ScreenRecorder" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.ScreenRecorder.Linux" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Net.Http" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Core.Linux" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Printers" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Printers.BluetoothLE" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Printers.Network" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Printing" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Printing.Rendering" Version="$(ShinyVersion)"/>
        <!-- Shiny.Printing.Rendering's: decodes receipt images in the printers bridge. Linux apps add the native assets. -->
        <PackageVersion Include="SkiaSharp" Version="4.151.1"/>
        <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.151.1"/>
        <PackageVersion Include="Xamarin.AndroidX.DocumentFile" Version="1.1.0.3"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0"/>
        <PackageVersion Include="PolySharp" Version="1.16.0"/>
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12"/>
        <PackageVersion Include="Microsoft.Maui.Controls" Version="$(MauiVersion)"/>
        <PackageVersion Include="Tmds.DBus.Protocol" Version="0.94.1"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.MacOS" Version="$(MauiLabsVersion)"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.MacOS.Essentials" Version="$(MauiLabsVersion)"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.Linux.Gtk4" Version="$(MauiLabsVersion)"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.Linux.Gtk4.Essentials" Version="$(MauiLabsVersion)"/>
        <PackageVersion Include="Microsoft.Maui.DevFlow.Agent" Version="$(MauiLabsVersion)"/>
    </ItemGroup>
    <ItemGroup>
        <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.12"/>
        <PackageVersion Include="xunit.v3" Version="3.2.2"/>
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0"/>
        <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="1.9.1"/>
    </ItemGroup>
</Project>