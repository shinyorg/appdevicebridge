<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <MauiVersion>11.0.10</MauiVersion>
        <MauiLabsVersion>0.1.0-preview.16.26575.3</MauiLabsVersion>
        <MauiDevFlowVersion>$(MauiLabsVersion)</MauiDevFlowVersion>
        <ShinyVersion>7.2.0</ShinyVersion>
        <ShinyControlsVersion>3.0.0</ShinyControlsVersion>
        <DocumentDbVersion>14.4.1</DocumentDbVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="GirCore.Gtk-4.0" Version="0.8.1"/>
        <PackageVersion Include="Jint" Version="4.18.1"/>
        <PackageVersion Include="XenoAtom.Terminal.UI" Version="3.12.0"/>
        <PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0"/>
        <PackageVersion Include="SkiaSharp" Version="4.158.0"/>
        <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.158.0"/>
        <PackageVersion Include="Xamarin.AndroidX.DocumentFile" Version="1.1.0.4"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0"/>
        <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0"/>
        <PackageVersion Include="PolySharp" Version="1.17.1"/>
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.Maui.Controls" Version="$(MauiVersion)"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.MacOS" Version="$(MauiLabsVersion)"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.MacOS.Essentials" Version="$(MauiLabsVersion)"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.Linux.Gtk4" Version="$(MauiLabsVersion)"/>
        <PackageVersion Include="Microsoft.Maui.Platforms.Linux.Gtk4.Essentials" Version="$(MauiLabsVersion)"/>
        <PackageVersion Include="Microsoft.Maui.DevFlow.Agent" Version="$(MauiDevFlowVersion)"/>
    </ItemGroup>
    <ItemGroup>
        <PackageVersion Include="Shiny.Net.HttpServer" Version="3.1.2"/>
        <PackageVersion Include="Shiny.Net.HttpServer.Ssh" Version="3.1.2"/>
        <PackageVersion Include="Shiny.Net.HttpServer.Mcp" Version="3.1.2"/>
        <PackageVersion Include="Shiny.UniversalHubs.Host" Version="2.0.1"/>
        <PackageVersion Include="Shiny.UniversalHubs.Client" Version="2.0.1"/>
        <PackageVersion Include="Shiny.UniversalHubs.Multipeer" Version="2.0.1"/>
        <PackageVersion Include="Shiny.BluetoothLE.Hubs" Version="2.0.1"/>
        <PackageVersion Include="Shiny.Extensions.Stores" Version="6.0.2"/>
        <PackageVersion Include="Shiny.Maui.Controls.Desktop" Version="$(ShinyControlsVersion)"/>
        <PackageVersion Include="Shiny.Maui.Controls.Camera" Version="$(ShinyControlsVersion)"/>
        <PackageVersion Include="Shiny.Maui.Controls.Analysis.Barcode" Version="$(ShinyControlsVersion)"/>
        <PackageVersion Include="Shiny.Hosting.Maui" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Core" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.AppStore" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Jobs" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Push" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Notifications" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Wearables" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Mobile.LiveActivities" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Mobile.InAppPurchases" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Mobile.CallDirectory" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.AgeSignals" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Biometrics" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Nfc" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Net.Vpn" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Net.Vpn.Linux" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.GameCenter" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Notifications.Linux" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Net.Wifi" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Net.Wifi.Linux" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Net.Discovery" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Obd" Version="2.0.0"/>
        <PackageVersion Include="Shiny.Obd.Ble" Version="2.0.0"/>
        <PackageVersion Include="Shiny.Obd.Wifi" Version="2.0.0"/>
        <PackageVersion Include="Shiny.Obd.Bluetooth" Version="2.0.0"/>
        <PackageVersion Include="Shiny.Obd.Emulator" Version="2.0.0"/>
        <PackageVersion Include="Shiny.Gps" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Gps.Linux" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Geofencing" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Geofencing.Regions" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Geofencing.Regions.DocumentDb" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.DocumentDb.Sqlite" Version="$(DocumentDbVersion)"/>
        <PackageVersion Include="Shiny.BluetoothLE" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Beacons" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Health" Version="2.1.0"/>
        <PackageVersion Include="Shiny.Contacts" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Calendar" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Speech" Version="3.0.0"/>
        <PackageVersion Include="Shiny.Audio" Version="3.0.0"/>
        <PackageVersion Include="Shiny.Audio.Linux" Version="3.0.0"/>
        <PackageVersion Include="Shiny.AiConversation" Version="3.0.0"/>
        <PackageVersion Include="Shiny.AiConversation.Voice" Version="3.0.0"/>
        <PackageVersion Include="Shiny.AiConversation.OpenAi" Version="3.0.0"/>
        <PackageVersion Include="Shiny.ScreenRecorder" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.ScreenRecorder.Linux" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Net.Http" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Printers" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Printers.BluetoothLE" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Printers.Network" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Printing" Version="$(ShinyVersion)"/>
        <PackageVersion Include="Shiny.Printing.Rendering" Version="$(ShinyVersion)"/>
    </ItemGroup>
    <ItemGroup>
        <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="11.0.0"/>
        <PackageVersion Include="xunit.v3" Version="4.0.3"/>
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.1"/>
        <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.3"/>
    </ItemGroup>
</Project>