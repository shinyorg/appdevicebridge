<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 only: AddAppSupport and AddAppStore have the same signature on every target, so the
         head's own platform build of Shiny.Extensions.MauiHosting supplies the implementation. -->
    <UseMaui>true</UseMaui>
    <SingleProject>false</SingleProject>
    <RootNamespace>Shiny.AppDeviceBridge.AppSupport</RootNamespace>
    <Description>Device and app information, orientation, browser, maps, settings, app store, launch-at-login (Windows, macOS, Linux), sharing, haptics, vibration, connectivity, battery, screen and clipboard endpoints, plus motion and environment sensors (accelerometer, gyroscope, magnetometer, compass, barometer, orientation) as live events, for a Shiny.AppDeviceBridge web app, backed by Shiny.Extensions.MauiHosting and .NET MAUI Essentials. One call: bridge.AddAppSupportBridge().</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Shiny.Extensions.MauiHosting" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shiny.AppDeviceBridge.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Shiny.AppDeviceBridge.Maui/Shiny.AppDeviceBridge.Maui.csproj" />
    <ProjectReference Include="../Shiny.AppDeviceBridge.AppSupport.Client/Shiny.AppDeviceBridge.AppSupport.Client.csproj" />
  </ItemGroup>

</Project>
