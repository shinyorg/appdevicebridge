<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 only: AddJob has one signature everywhere, so each head's own platform build of Shiny.Jobs is what
         runs. Shiny's jobs run inside a Shiny host, which the app's host starts (UseAppDeviceBridge does on MAUI). -->
    <RootNamespace>Shiny.AppDeviceBridge.Jobs</RootNamespace>
    <Description>Background jobs for a Shiny.AppDeviceBridge web app, scheduled by Shiny.Jobs and handled by the page when it is open or by background.js when it is not. One call per job: bridge.AddWebAppJob("sync", job => job.WithInternet(InternetAccess.Any)).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Shiny.Jobs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Shiny.AppDeviceBridge/Shiny.AppDeviceBridge.csproj" />
  </ItemGroup>

</Project>
