<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Cleared: src/Directory.Build.props sets the single target. -->
    <TargetFramework></TargetFramework>

    <!-- Shiny.Net.Wifi declares AddWifi on its platform targets only, so the maui-labs macOS head gets a build of
         its own. The net10.0 build serves Linux with the NetworkManager implementation, and registers nothing
         anywhere else. No MAUI: the app's host starts Shiny where its managers need it. -->
    <TargetFrameworks>net10.0;net10.0-android;net10.0-ios;net10.0-maccatalyst;net10.0-macos</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

    <RootNamespace>Shiny.AppDeviceBridge.Wifi</RootNamespace>
    <Description>Wi-Fi endpoints for a Shiny.AppDeviceBridge web app, backed by Shiny.Net.Wifi — the current network and its changes, scanning, connecting, known networks, the radio, and optionally a hotspot. One call: bridge.AddWifiBridge().</Description>

    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-android'))">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-ios'))">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-maccatalyst'))">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-macos'))">14.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Shiny.Net.Wifi" />
  </ItemGroup>

  <!-- Linux Wi-Fi is NetworkManager over D-Bus, shipped separately so no other platform carries it. Only the
       net10.0 build references it, and it is only called when the process is actually on Linux. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Shiny.Net.Wifi.Linux" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <DefineConstants>$(DefineConstants);WIFI_LINUX</DefineConstants>
  </PropertyGroup>

  <!-- On macOS no Shiny host is started for the app, so the bridge registers Shiny's core services itself. -->
  <ItemGroup Condition="$(TargetFramework.Contains('-macos'))">
    <Compile Include="../Shared/ShinyCoreHosting.cs" Link="ShinyCoreHosting.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Shiny.AppDeviceBridge/Shiny.AppDeviceBridge.csproj" />
    <ProjectReference Include="../Shiny.AppDeviceBridge.Wifi.Client/Shiny.AppDeviceBridge.Wifi.Client.csproj" />
  </ItemGroup>

</Project>
