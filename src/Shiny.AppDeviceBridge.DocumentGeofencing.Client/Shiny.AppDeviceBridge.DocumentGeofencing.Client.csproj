<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../BridgeClient.props" />

  <PropertyGroup>
    <RootNamespace>Shiny.AppDeviceBridge.DocumentGeofencing.Client</RootNamespace>
    <Description>Typed client and contracts for the Shiny.AppDeviceBridge document geofencing bridge — start and stop GPS-driven monitoring of polygon and proximity regions stored in Shiny.DocumentDb, read the regions the device is in, and hear when it enters or leaves one — for a web app hosted by Shiny.AppDeviceBridge. Register with services.AddDocumentGeofencesBridgeClient().</Description>
  </PropertyGroup>

</Project>
