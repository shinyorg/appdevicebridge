<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Shiny.AppDeviceBridge</RootNamespace>
    <Description>The bridge server: native device services as HTTP endpoints on a fully configurable Shiny.Net.HttpServer, callable from a web page, a script or another app. Bridges answer callers on this device only by default (any caller in a debug build), and who may call them is an authorization policy you can replace. No MAUI dependency; Shiny.AppDeviceBridge.WebView adds a WebView host with over-the-air updates.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Shiny.Net.HttpServer" />

    <!-- One AddShinyStores signature on every target, so this net10.0 build can call it and each head
         still gets its platform store: Keychain, Android KeyStore, DPAPI, or a file on Linux. -->
    <PackageReference Include="Shiny.Extensions.Stores" />

    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Shiny.AppDeviceBridge.Core/Shiny.AppDeviceBridge.Core.csproj" />
    <ProjectReference Include="../Shiny.AppDeviceBridge.Client/Shiny.AppDeviceBridge.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shiny.AppDeviceBridge.Tests" />
  </ItemGroup>

</Project>
