<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- One target: Shiny.Mobile.LiveActivities carries the platform code (ActivityKit on iOS, Live Updates on Android)
         and NuGet picks its build for the app's head. Everywhere else its manager is a no-op that reports itself
         unsupported, and the bridge answers 501. -->
    <RootNamespace>Shiny.AppDeviceBridge.LiveActivities</RootNamespace>
    <Description>Live activities for a Shiny.AppDeviceBridge web app, backed by Shiny.Mobile.LiveActivities — iOS Live Activities and Android 16 Live Updates: start, update and end them from the page, and receive their push tokens in the page or background.js. One call: bridge.AddLiveActivitiesBridge().</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Shiny.Mobile.LiveActivities" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shiny.AppDeviceBridge.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Shiny.AppDeviceBridge/Shiny.AppDeviceBridge.csproj" />
    <ProjectReference Include="../Shiny.AppDeviceBridge.LiveActivities.Client/Shiny.AppDeviceBridge.LiveActivities.Client.csproj" />
  </ItemGroup>

</Project>
