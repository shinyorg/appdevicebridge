<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Cleared: src/Directory.Build.props sets the single target. -->
    <TargetFramework></TargetFramework>

    <!-- On-device routing runs valhalla-mobile's native engine, which exists for Android and iOS. The net10.0 build lets
         a shared project call AddOnDeviceDirections() on every head; there it registers nothing, and directions go
         online. Mac Catalyst is absent because valhalla-mobile's xcframework has no Catalyst slice. -->
    <TargetFrameworks>net10.0;net10.0-android;net10.0-ios</TargetFrameworks>

    <RootNamespace>Shiny.AppDeviceBridge.Maps.Valhalla</RootNamespace>
    <Description>On-device turn-by-turn directions for Shiny.AppDeviceBridge.Maps, from Valhalla (via valhalla-mobile) running against the road network of a region the user downloaded — so directions work with no connection. Android and iOS; other platforms route online. One call: bridge.AddOnDeviceDirections().</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-android'))">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-ios'))">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="valhalla-config.json" LogicalName="valhalla-config.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shiny.AppDeviceBridge.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Shiny.AppDeviceBridge.Maps/Shiny.AppDeviceBridge.Maps.csproj" />
  </ItemGroup>

  <Import Project="Valhalla.targets" />

</Project>
