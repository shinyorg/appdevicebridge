<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Cleared: src/Directory.Build.props sets the single target. -->
    <TargetFramework></TargetFramework>

    <!-- Multi-targeted like the OBD bridge: Bluetooth printers need Shiny.BluetoothLE's platform builds, the only ones that
         register a real IBleManager. Network printers are plain TCP and work from every target, Linux's net10.0 included. -->
    <TargetFrameworks>net10.0;net10.0-android;net10.0-ios;net10.0-maccatalyst;net10.0-macos</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

    <RootNamespace>Shiny.AppDeviceBridge.Printers</RootNamespace>
    <Description>Receipt and label printers for a Shiny.AppDeviceBridge web app, backed by Shiny.Printers — find ESC/POS and TSPL printers over Bluetooth LE or the network, connect, print receipts the page builds, and render them to PDF. One call: bridge.AddPrintersBridge().</Description>

    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-android'))">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-ios'))">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-maccatalyst'))">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-macos'))">14.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Shiny.BluetoothLE" />
    <PackageReference Include="Shiny.Printers" />
    <PackageReference Include="Shiny.Printers.BluetoothLE" />
    <PackageReference Include="Shiny.Printers.Network" />
    <PackageReference Include="Shiny.Printing.Rendering" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shiny.AppDeviceBridge.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The page may only name a printer on the local network. -->
    <Compile Include="../Shared/LocalNetwork.cs" Link="LocalNetwork.cs" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('-macos'))">
    <Compile Include="../Shared/ShinyCoreHosting.cs" Link="ShinyCoreHosting.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Shiny.AppDeviceBridge/Shiny.AppDeviceBridge.csproj" />
    <ProjectReference Include="../Shiny.AppDeviceBridge.Printers.Client/Shiny.AppDeviceBridge.Printers.Client.csproj" />
  </ItemGroup>

</Project>
