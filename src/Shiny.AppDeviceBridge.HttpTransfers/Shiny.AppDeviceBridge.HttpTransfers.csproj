<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Cleared: src/Directory.Build.props sets the single target. -->
    <TargetFramework></TargetFramework>

    <!-- Multi-targeted because the registration differs by platform: AddHttpTransfers registers the native
         manager (NSURLSession on Apple, a foreground service on Android) only in Shiny.Net.Http's platform builds,
         and needs Shiny's host. macOS has no Shiny.Net.Http build, so it gets the managed HttpClient loop over
         Shiny.Core's macOS connectivity; the net11.0 build does the same on Linux. -->
    <TargetFrameworks>net11.0;net11.0-android;net11.0-ios;net11.0-maccatalyst;net11.0-macos</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net11.0-windows10.0.19041.0</TargetFrameworks>

    <RootNamespace>Shiny.AppDeviceBridge.HttpTransfers</RootNamespace>
    <Description>Background HTTP uploads and downloads for a Shiny.AppDeviceBridge web app, backed by Shiny.Net.Http — queue, list, pause, resume and cancel transfers into and out of the files bridge's roots, with progress events and completion handlers that run in the page. One call: bridge.AddHttpTransfersBridge().</Description>

    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-android'))">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-ios'))">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-maccatalyst'))">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-macos'))">14.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Shiny.Net.Http" />
  </ItemGroup>

  <!-- The managed loop waits on Shiny.Core's connectivity, which its net11.0 build implements for Linux. It is only
       registered when the process is actually on Linux. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <DefineConstants>$(DefineConstants);TRANSFERS_LINUX</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Shiny.AppDeviceBridge/Shiny.AppDeviceBridge.csproj" />
    <ProjectReference Include="../Shiny.AppDeviceBridge.HttpTransfers.Client/Shiny.AppDeviceBridge.HttpTransfers.Client.csproj" />
  </ItemGroup>

</Project>
