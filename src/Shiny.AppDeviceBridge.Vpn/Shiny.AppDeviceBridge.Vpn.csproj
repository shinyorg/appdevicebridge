<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Cleared: src/Directory.Build.props sets the single target. -->
    <TargetFramework></TargetFramework>

    <!-- Shiny.Net.Vpn declares AddVpn on its platform targets only, so the maui-labs macOS head gets a build of its own.
         The net10.0 build serves Linux with the NetworkManager implementation, and registers nothing anywhere else:
         there is no Windows VPN client to drive, so Windows answers 501. -->
    <TargetFrameworks>net10.0;net10.0-android;net10.0-ios;net10.0-maccatalyst;net10.0-macos</TargetFrameworks>

    <RootNamespace>Shiny.AppDeviceBridge.Vpn</RootNamespace>
    <Description>The app's profile in the operating system's built-in IKEv2 VPN client, for a Shiny.AppDeviceBridge web app, backed by Shiny.Net.Vpn — save and remove the profile, connect, disconnect and watch the tunnel. One call: bridge.AddVpnBridge().</Description>

    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-android'))">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-ios'))">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-maccatalyst'))">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-macos'))">14.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Shiny.Net.Vpn" />
  </ItemGroup>

  <!-- Linux VPN is NetworkManager's strongSwan plugin over D-Bus, shipped separately so no other platform carries it.
       Only the net10.0 build references it, and it is only called when the process is actually on Linux. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Shiny.Net.Vpn.Linux" />
  </ItemGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <DefineConstants>$(DefineConstants);VPN_LINUX</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shiny.AppDeviceBridge.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Shiny.AppDeviceBridge/Shiny.AppDeviceBridge.csproj" />
    <ProjectReference Include="../Shiny.AppDeviceBridge.Vpn.Client/Shiny.AppDeviceBridge.Vpn.Client.csproj" />
  </ItemGroup>

</Project>
