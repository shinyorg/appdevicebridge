<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Cleared: src/Directory.Build.props sets the single target. -->
    <TargetFramework></TargetFramework>

    <!-- Multi-targeted like the Bluetooth LE bridge: BLE adapters need Shiny.BluetoothLE's platform builds, the
         only ones that register a real IBleManager. Wi-Fi adapters are plain TCP and work from every target,
         the plain net11.0 one (Linux) included. -->
    <TargetFrameworks>net11.0;net11.0-android;net11.0-ios;net11.0-maccatalyst;net11.0-macos</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net11.0-windows10.0.19041.0</TargetFrameworks>

    <RootNamespace>Shiny.AppDeviceBridge.Obd</RootNamespace>
    <Description>OBD-II vehicle diagnostics for a Shiny.AppDeviceBridge web app, backed by Shiny.Obd — find Bluetooth LE adapters, connect over BLE or Wi-Fi, read decoded PIDs, the VIN and trouble codes, and stream readings to the page as events. One call: bridge.AddObdBridge().</Description>

    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-android'))">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-ios'))">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-maccatalyst'))">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-macos'))">14.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-windows'))">10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Shiny.BluetoothLE" />
    <PackageReference Include="Shiny.Obd" />
    <PackageReference Include="Shiny.Obd.Ble" />
    <PackageReference Include="Shiny.Obd.Wifi" />
  </ItemGroup>

  <ItemGroup>
    <!-- Wi-Fi adapters run their own access point on a private address; the page may only name one of those. -->
    <Compile Include="../Shared/LocalNetwork.cs" Link="LocalNetwork.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The simulator mounts the bridge's handlers behind its own routes, to switch between it and a simulated one. -->
    <InternalsVisibleTo Include="Shiny.AppDeviceBridge.Simulator" />
    <InternalsVisibleTo Include="Shiny.AppDeviceBridge.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Shiny.AppDeviceBridge/Shiny.AppDeviceBridge.csproj" />
    <ProjectReference Include="../Shiny.AppDeviceBridge.Obd.Client/Shiny.AppDeviceBridge.Obd.Client.csproj" />
  </ItemGroup>

</Project>
