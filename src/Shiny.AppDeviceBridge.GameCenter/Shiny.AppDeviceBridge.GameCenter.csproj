<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- One target: Shiny.GameCenter carries the platform code (GameKit on Apple, Play Games Services v2 on Android) and
         NuGet picks its build for the app's head. Everywhere else its provider is local-only, and the bridge answers 501. -->
    <RootNamespace>Shiny.AppDeviceBridge.GameCenter</RootNamespace>
    <Description>Game services for a Shiny.AppDeviceBridge web app, backed by Shiny.GameCenter — Apple Game Center and Google Play Games sign-in, achievements, leaderboards, friends and the services' own UI from the page, with progress queued on the device while offline. One call: bridge.AddGameCenterBridge().</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Shiny.GameCenter" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shiny.AppDeviceBridge.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Shiny.AppDeviceBridge/Shiny.AppDeviceBridge.csproj" />
    <ProjectReference Include="../Shiny.AppDeviceBridge.GameCenter.Client/Shiny.AppDeviceBridge.GameCenter.Client.csproj" />
  </ItemGroup>

</Project>
