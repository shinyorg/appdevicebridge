<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Shiny.AppDeviceBridge.Tunnel</RootNamespace>
    <Description>A public HTTPS address for a Shiny.AppDeviceBridge server, opened and closed while the app runs — an SSH tunnel to a public host such as pinggy, in managed code, so it works on phones as well as desktops. Everything arriving through it is treated as a caller from the network: never on the device, never the WebView. Plain net10.0 with no MAUI. One call: bridge.AddTunnel().</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Shiny.Net.HttpServer.Ssh" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Shiny.AppDeviceBridge/Shiny.AppDeviceBridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shiny.AppDeviceBridge.Tests" />
  </ItemGroup>

</Project>
