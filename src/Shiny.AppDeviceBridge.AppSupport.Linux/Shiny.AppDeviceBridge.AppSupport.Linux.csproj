<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Plain net10.0 like the GTK4 head itself. Separate from Shiny.AppDeviceBridge.AppSupport, which every head
         references, so only a Linux head carries D-Bus. -->
    <UseMaui>true</UseMaui>
    <SingleProject>false</SingleProject>
    <RootNamespace>Shiny.AppDeviceBridge.AppSupport.Linux</RootNamespace>
    <Description>Battery and energy saver for Shiny.AppDeviceBridge.AppSupport on the Linux (GTK4) head, as a .NET MAUI Essentials IBattery over D-Bus — UPower for the charge, state and power source, power-profiles-daemon for energy saver — raising change events as UPower reports them. One call on the Linux head: builder.AddAppSupportLinux().</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Tmds.DBus.Protocol" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shiny.AppDeviceBridge.Tests" />
  </ItemGroup>

</Project>
